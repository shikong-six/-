# ===== 服务端口 =====
PORT=3000

# ===== Kimi 大模型（Moonshot AI）=====
# 去 https://platform.moonshot.cn 申请 API Key
KIMI_API_KEY=
# 官方默认地址，如用第三方代理再改
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== MySQL 数据库 =====
DB=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fazhitong

# ===== Ollama 本地向量化 =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ===== LanceDB 向量库文件目录（默认 houduan/vector_db/）=====
LANCEDB_PATH=

# ===== JWT 认证密钥（生产环境必须改成随机长字符串）=====
JWT_SECRET=
